{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=PaySphereWalletDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  "Jwt": {
    "Key": "ThisIsASecretKeyForPaySphereAuthService2026",
    "Issuer": "PaySphere.AuthService",
    "Audience": "PaySphere.Client",
    "ExpiryInMinutes": 60
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "../../logs/wallet-service-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },

  "AllowedHosts": "*"
}