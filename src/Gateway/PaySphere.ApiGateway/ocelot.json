// Ocelot configuration file for API Gateway
// This file defines the routing rules and downstream services for the API Gateway.
// The configuration includes routes for authentication and wallet services, as well as global settings and Swagger endpoints.
// Note: Ensure that the downstream services are running and accessible at the specified host and port.

{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/v1/auth/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7213
        }
      ],
      "UpstreamPathTemplate": "/api/v1/auth/{everything}",
      "UpstreamHttpMethod": [ "Get", "Post", "Put", "Delete", "Options" ],
      "SwaggerKey": "auth"
    },


    {
      "DownstreamPathTemplate": "/api/v1/wallets/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7261
        }
      ],
      "UpstreamPathTemplate": "/api/v1/wallets/{everything}",
      "UpstreamHttpMethod": [ "Get", "Post", "Put", "Delete", "Options" ],
      "SwaggerKey": "wallet"
    },


    {
      "DownstreamPathTemplate": "/api/v1/wallets",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7261
        }
      ],
      "UpstreamPathTemplate": "/api/v1/wallets",
      "UpstreamHttpMethod": [ "Get", "Post", "Put", "Delete", "Options" ],
      "SwaggerKey": "wallet"
    }
  ],

  "GlobalConfiguration": {
    "BaseUrl": "https://localhost:7265"
  },
  "SwaggerEndPoints": [
    {
      "Key": "auth",
      "Config": [
        {
          "Name": "AuthService",
          "Version": "v1",
          "Url": "https://localhost:7213/swagger/v1/swagger.json"
        }
      ]
    },
    {
      "Key": "wallet",
      "Config": [
        {
          "Name": "WalletService",
          "Version": "v1",
          "Url": "https://localhost:7261/swagger/v1/swagger.json"
        }
      ]
    }
  ]
}
